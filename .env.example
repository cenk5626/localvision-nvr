# LocalVision NVR - Çevre Değişkenleri Şablonu

# Temel Uygulama Ayarları
APP_NAME="LocalVision NVR"
APP_VERSION="1.0.0"
DEBUG=false
OFFLINE_ONLY=true

# Ağ ve Portlar
HOST="0.0.0.0"
PORT=8000

# Güvenlik Anahtarları (Üretim ortamında benzersiz ve güçlü anahtarlar oluşturun)
JWT_SECRET_KEY="localvision_nvr_secure_jwt_token_secret_key_change_in_prod_2026"
JWT_ALGORITHM="HS256"
AES_SECRET_KEY="localvision_aes_256_gcm_32byte_master_secret_key!"

# Veritabanı (Varsayılan: Yerel SQLite WAL; PostgreSQL için postgresql+asyncpg://user:pass@localhost:5432/nvr)
DATABASE_URL="sqlite+aiosqlite:///./data/localvision.db"

# İlk Kurulum Yönetici Kullanıcısı
FIRST_ADMIN_USERNAME="admin"
FIRST_ADMIN_PASSWORD="Admin*LocalVision2026!"
FIRST_ADMIN_EMAIL="admin@localvision.local"

# Yapay Zekâ Ayarları
AI_ENABLED=true
AI_USE_GPU=true
AI_MODEL_NAME="yolov8n.pt"
AI_FALLBACK_TO_OPENCV=true
